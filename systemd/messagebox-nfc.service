[Unit]
ConditionPathExists=!/var/lib/button-box-update/install-inhibit
Description=Button Box PN532 recipient-card reader
After=local-fs.target messagebox-audio-detect.service
Requires=messagebox-audio-detect.service
Before=messagebox-button.service
PartOf=messagebox.target

[Service]
Type=simple
User=messagebox
Group=messagebox
WorkingDirectory=/opt/messagebox
EnvironmentFile=/etc/messagebox/env
EnvironmentFile=/run/messagebox-audio/audio.env
Environment=HOME=/var/lib/messagebox
SupplementaryGroups=i2c gpio
UMask=0077
# Channel boxes have no NFC reader; skip cleanly instead of failing.
ExecCondition=+/bin/sh -c '! grep -Eq "^MSGBOX_CHANNEL_PINS=.+" /etc/messagebox/env'
ExecStart=/opt/messagebox/venv-nfc/bin/python -u -m messagebox.nfc daemon
Restart=always
RestartSec=3

[Install]
WantedBy=messagebox.target
